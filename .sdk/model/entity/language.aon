# Entity: language

main: kit: entity: language: {

  alias: field: {}

  fields: [
    {
      name: "author"
      req: true
      short: "The author of the phrase or source reference"
      type: "`$STRING`"
    }
    {
      name: "phrase"
      req: true
      short: "The motivational phrase text"
      type: "`$STRING`"
    }
    {
      name: "religion"
      req: true
      short: "Indicates if the phrase is religious."
      type: "`$INTEGER`"
    }
  ]

  name: "language"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            params: [
              {
                example: "en"
                kind: "param"
                name: "language"
                orig: "language"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /{language}.json"
            json: "{\"operationId\":\"getMotivationalPhrases\",\"parameters\":[{\"description\":\"Language code for the motivational phrases\",\"examples\":{\"english\":{\"summary\":\"English phrases\",\"value\":\"en\"},\"french\":{\"summary\":\"French phrases\",\"value\":\"fr\"},\"japanese\":{\"summary\":\"Japanese phrases\",\"value\":\"ja\"},\"spanish\":{\"summary\":\"Spanish phrases\",\"value\":\"es\"}},\"in\":\"path\",\"name\":\"language\",\"required\":true,\"schema\":{\"enum\":[\"en\",\"es\",\"fr\",\"ja\"],\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"examples\":{\"phrases\":{\"summary\":\"Example motivational phrases\",\"value\":[{\"author\":\"Robert Frost\",\"phrase\":\"The only way out is through.\",\"religion\":0},{\"author\":\"Philippians 4:13\",\"phrase\":\"I can do all things through Christ who strengthens me.\",\"religion\":1}]}},\"schema\":{\"items\":{\"properties\":{\"author\":{\"description\":\"The author of the phrase or source reference\",\"type\":\"string\"},\"phrase\":{\"description\":\"The motivational phrase text\",\"type\":\"string\"},\"religion\":{\"description\":\"Indicates if the phrase is religious. 1 = catholic, 0 = non-religious\",\"enum\":[0,1],\"type\":\"integer\"}},\"required\":[\"phrase\",\"author\",\"religion\"],\"type\":\"object\"},\"type\":\"array\"}}},\"description\":\"Successful response with array of motivational phrases\"},\"404\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"code\":{\"description\":\"Error code\",\"type\":\"integer\"},\"message\":{\"description\":\"Error message\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Language file not found\"},\"500\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"code\":{\"description\":\"Error code\",\"type\":\"integer\"},\"message\":{\"description\":\"Error message\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Server error\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/{language}.json"
          segments: [
            {
              lit: "{language}.json"
            }
          ]
          select: {
            exist: [
              "language"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
