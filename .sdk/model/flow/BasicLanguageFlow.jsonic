# BasicLanguageFlow

main: kit: flow: BasicLanguageFlow:
{
  entity: "language",
  kind: "basic",
  name: "BasicLanguageFlow",
  step: [
    {
      match: {
        language: "language01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "language_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicLanguageFlow"
}