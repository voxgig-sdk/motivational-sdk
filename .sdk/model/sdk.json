        "contact": {
          "url": "https://github.com/GomezMig03/MotivationalAPI"
        },
        "description": "This API provides a collection of catholic and secular motivational phrases to help users overcome their challenges. It is intended to be utilized in applications focused on motivation and support, like addiction recovery tools.",
        "license": {
          "name": "MIT",
          "url": "https://github.com/GomezMig03/MotivationalAPI/blob/main/LICENSE"
        },
        "servers": [
          {
            "description": "jsDelivr CDN server",
            "url": "https://cdn.jsdelivr.net/gh/GomezMig03/MotivationalAPI"
          }
        ],
        "title": "Motivational API",
        "version": "1.0.0",
        "tagline": "Catholic and secular motivational phrases served as JSON, one file per language",
        "homepage": "https://github.com/GomezMig03/MotivationalAPI",
        "docs_url": "https://github.com/GomezMig03/MotivationalAPI",
        "license_short": "MIT License",
        "license_md": "- Source content and code are released under the MIT License.\n- Contributions of new phrases, translations, and corrections are welcomed by the upstream project.\n- Attribution to the original authors of each quote is included via the `author` field on each phrase.",
        "about_md": "The Motivational API is a small open-source dataset of motivational phrases maintained by [GomezMig03](https://github.com/GomezMig03/MotivationalAPI). It mixes Catholic and secular quotes, originally assembled to support an addiction-management application, and it is served as static JSON via the [jsDelivr CDN](https://cdn.jsdelivr.net/gh/GomezMig03/MotivationalAPI) directly from the GitHub repository.\n\nWhat you get from the API:\n\n- One JSON file per supported language at `https://cdn.jsdelivr.net/gh/GomezMig03/MotivationalAPI/<language>.json` (for example `en.json`, `es.json`, `fr.json`, `ja.json`).\n- Each file is an array of phrase objects with the fields `phrase` (the quote), `author` (attribution), and `religion` (`1` for Catholic, `0` for non-religious).\n- Clients typically fetch a language file once and pick a random entry locally.\n\nOperational notes: no authentication is required, CORS is enabled, and the data is delivered as cached static files through jsDelivr, so request volume is bounded by the CDN rather than a per-key rate limit.",
        "entity_desc": {
          "language": "A language-specific collection of motivational phrases, fetched as a single JSON array from `https://cdn.jsdelivr.net/gh/GomezMig03/MotivationalAPI/<language>.json` (e.g. `en.json`, `es.json`, `fr.json`, `ja.json`)."
        },
